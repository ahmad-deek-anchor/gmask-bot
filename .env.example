# Copy to .env. Every value is optional: API keys fall back to GCP Secret Manager
# (project anchorage-trading-solutions) when the env var is unset.

# --- Market data API keys (override Secret Manager) -------------------------
# COINMETRICS_API_KEY=            # secret: coinmetrics_trial_api
# AMBERDATA_API_KEY=              # secret: amberdata_key

# --- GCP --------------------------------------------------------------------
# GCP_SECRETS_PROJECT=anchorage-trading-solutions

# --- Claude via Vertex AI Model Garden --------------------------------------
# VERTEX_PROJECT=anchorage-ai-development
# VERTEX_LOCATION=us-east5
# VERTEX_MODEL=claude-sonnet-4-6

# --- Slack bot (slack_bot.py) and daily post (run_signals.py --post-slack) ---
# SLACK_BOT_TOKEN=                # xoxb-...  secret: trading_signals_slack_bot_token
# SLACK_APP_TOKEN=                # xapp-...  secret: trading_signals_slack_app_token
# SLACK_CHANNEL_ID=               # C...      secret: trading_signals_slack_channel_id (daily post target)
# SLACK_BOT_DB=data/slack_bot.db  # SQLite conversation memory for the bot
# SLACK_WEBHOOK_URL=              # legacy incoming webhook; env only, never read from Secret Manager
# SLACK_SESSION_IDLE_MIN=120         # new conversation after this many idle minutes

# --- Desk data in BigQuery (read-only; providers/bigquery.py) -----------------
# BQ_DATA_PROJECT=anc-global-markets            # where the desk tables live
# BQ_BILLING_PROJECT=anchorage-corp-eng-playground   # jobs run + are billed here (no jobs.create in the data project)
# BQ_ALLOWED_DATASETS=brokerage_a1,pricing      # the only datasets the agent may reference
# BQ_MAX_BYTES_BILLED=2000000000                # per-query cost cap (2 GB)
# BQ_MAX_ROWS=200                               # LIMIT enforced on every query
# BQ_TIMEOUT_S=60
# BQ_CATALOG_PATH=data/bq_catalog.json          # 24 h cache of table schemas
# SLACK_REPLY_IN_THREAD=0        # 1 = answer in a thread under the question instead of in the channel
